# Adapter selection: "mock" (default, no infra) or "openstack" (real cloud)
ADAPTER_MODE=mock

# Persistence (SQLAlchemy async URL)
DATABASE_URL=sqlite+aiosqlite:///./dr.db

# DR defaults
DEFAULT_RTO_MINUTES=15
MOCK_LATENCY_MS=250

# OpenStack settings (only required when ADAPTER_MODE=openstack)
OPENSTACK_AUTH_URL=
OPENSTACK_REGION_NAME=RegionOne
OPENSTACK_COMPUTE_API_VERSION=2
OPENSTACK_IDENTITY_INTERFACE=internal
OPENSTACK_PROJECT_ID=
OPENSTACK_USER_DOMAIN_ID=
OPENSTACK_PROJECT_DOMAIN_ID=